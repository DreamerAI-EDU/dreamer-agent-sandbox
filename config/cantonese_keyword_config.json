  "tone_rules": {
    "P1-P3": {
      "en": {
        "max_sentence_words": 10,
        "encouragement_every_n_turns": 2,
        "no_sarcasm": true,
        "positive_framing_only": true,
        "avoid_words": ["wrong", "incorrect", "fail", "bad"],
        "prefer_words": ["let's try", "almost", "good start", "keep going"]
      },
      "zh-hk": {
        "max_sentence_chars": 25,
        "encouragement_every_n_turns": 2,
        "no_sarcasm": true,
        "positive_framing_only": true,
        "avoid_words": ["錯", "唔啱", "失敗", "差"],
        "prefer_words": ["試下", "差少少", "幾好", "繼續"]
      },
      "zh-cn": {
        "max_sentence_chars": 25,
        "encouragement_every_n_turns": 2,
        "no_sarcasm": true,
        "positive_framing_only": true,
        "avoid_words": ["错", "不对", "失败", "差"],
        "prefer_words": ["试试", "差一点点", "不错", "继续"]
      }
    },
    "P4-P6": {
      "en": {
        "max_sentence_words": 15,
        "positive_framing": true,
        "allow_gentle_correction": true,
        "avoid_words": ["wrong"],
        "prefer_words": ["not quite", "let's check", "another way", "what if"]
      },
      "zh-hk": {
        "max_sentence_chars": 35,
        "positive_framing": true,
        "allow_gentle_correction": true,
        "avoid_words": ["錯晒"],
        "prefer_words": ["唔係好啱", "睇多次", "試另一個方法", "如果咁樣呢"]
      },
      "zh-cn": {
        "max_sentence_chars": 35,
        "positive_framing": true,
        "allow_gentle_correction": true,
        "avoid_words": ["全错"],
        "prefer_words": ["不太对", "再看一次", "试试另一种方法", "如果这样呢"]
      }
    },
    "S1-S3": {
      "en": {
        "full_sentences": true,
        "constructive_critique_ok": true,
        "no_grade_anxiety_language": true,
        "avoid_words": ["you failed", "you're behind", "not good enough"],
        "prefer_words": ["here's what to strengthen", "focus area", "let's build on"]
      },
      "zh-hk": {
        "full_sentences": true,
        "constructive_critique_ok": true,
        "no_grade_anxiety_language": true,
        "avoid_words": ["你唔得", "你落後", "唔夠好"],
        "prefer_words": ["呢度可以加強", "重點", "喺呢個基礎上"]
      },
      "zh-cn": {
        "full_sentences": true,
        "constructive_critique_ok": true,
        "no_grade_anxiety_language": true,
        "avoid_words": ["你不行", "你落后", "不够好"],
        "prefer_words": ["这里可以加强", "重点", "在这个基础上"]
      }
    }
  },

  "session_wrap_up": {
    "en": {
      "P1-P3": "Great session! You made progress on {topic}. Come back anytime — I'll be here! 🌟",
      "P4-P6": "Well done today! You worked on {topic}. Remember, practice makes progress. See you next time!",
      "S1-S3": "Solid session on {topic}. Your key takeaway: {summary}. Keep building on this — consistent practice is the way forward."
    },
    "zh-hk": {
      "P1-P3": "今日學得好叻呀！{topic} 進步咗好多。隨時返嚟搵我啦！",
      "P4-P6": "今日做得好好！{topic} 方面有進步。記得，練習就會越嚟越好。下次再見！",
      "S1-S3": "{topic} 方面嘅進度唔錯。重點回顧：{summary}。繼續努力，持之以恆就係成功之道。"
    },
    "zh-cn": {
      "P1-P3": "今天学得很棒！{topic} 进步了很多。随时回来找我吧！",
      "P4-P6": "今天做得很好！{topic} 方面有进步。记得，练习就会越来越好。下次再见！",
      "S1-S3": "{topic} 方面的进度不错。重点回顾：{summary}。继续努力，持之以恒就是成功之道。"
    }
  },

  "ethical_ai_tags": {
